# ========================================
# 敏感配置 & API Key（开源不提交）
# ========================================
config.ini

# ========================================
# 向量库 / ChromaDB 本地数据（运行时生成）
# ========================================
backend/agents/*_expert_agent/data/vector_db/

# ========================================
# Python
# ========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
*.egg
.eggs/

# 虚拟环境
venv/
.venv/
env/

# 日志 & 临时数据
*.log
*.db
*.sqlite
*.sqlite3

# ========================================
# IDE / 编辑器
# ========================================
.vscode/
.idea/
.trae/
*.swp
*.swo
.DS_Store
Thumbs.db
*.db-shm
*.db-wal

# ========================================
# Python 工具缓存
# ========================================
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ========================================
# 临时锁文件 / 调试日志
# ========================================
~$*
*.tmp
*.bak
*.orig
debug.txt

# ========================================
# 前端 Node.js
# ========================================
frontend/vue_app/node_modules/
frontend/vue_app/dist/
frontend/vue_app/.env
frontend/vue_app/.env.local

# ========================================
# 本地上传临时文件（运行时生成）
# ========================================
uploads/

# ========================================
# Excel 数据文件（仅开源示例数据放行，其余忽略）
# ========================================
*.xlsx
# 根目录两个主数据源
!data/蜗牛项目-VTS_SSTS_V6.0_ini.xlsx
!data/蜗牛项目-VTS_SSTS_V7.0.xlsx
# 蜗牛项目子目录下的派生 Excel（如 motor_parameter.xlsx）
!data/蜗牛项目/
!data/蜗牛项目/**/*.xlsx

# ========================================
# 项目本地运行时数据
# ========================================
backend/core/memory/*.db
backend/core/memory/*.sqlite3
